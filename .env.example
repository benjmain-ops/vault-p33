# Avalanche C-Chain RPC
RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Factory deployment (one time only)
DEPLOYER_PRIVATE_KEY=
KEEPER_ADDRESS=
TICK_SPACING=

# Keeper: a dedicated key, holding only a little AVAX for gas
KEEPER_PRIVATE_KEY=
FACTORY=
# Optional: restrict to specific vaults (comma-separated addresses)
VAULTS=
# Keeper gas alert threshold, in AVAX
MIN_GAS_AVAX=0.05
# DRY_RUN=1 to print what would be done without sending anything
DRY_RUN=
