# RPC Avalanche C-Chain
RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Déploiement de la factory (une seule fois)
DEPLOYER_PRIVATE_KEY=
KEEPER_ADDRESS=
TICK_SPACING=

# Keeper : une clé dédiée, avec seulement un peu d'AVAX pour le gas
KEEPER_PRIVATE_KEY=
FACTORY=
# Optionnel : limiter à certains vaults (adresses séparées par des virgules)
VAULTS=
# Seuil d'alerte de gas du robot, en AVAX
MIN_GAS_AVAX=0.05
# DRY_RUN=1 pour afficher ce qui serait fait sans rien envoyer
DRY_RUN=
