# Avalanche C-Chain RPC
RPC_URL=https://api.avax.network/ext/bc/C/rpc

# ── Player bot (keeper/player.js) ──
# Key of the dedicated player wallet. Never the key of the wallet that owns the vault.
PLAYER_PRIVATE_KEY=
# The vault that funds the player wallet
VAULT=
# Optional: fixed number of tickets per draw (default: spread the budget over the week)
TICKETS_PER_DRAW=
# Optional: WAVAX kept on the player wallet, in tickets; the rest goes to the vault's owner (default 100)
KEEP_TICKETS=
# DRY_RUN=1 to print what would be done without sending anything
DRY_RUN=

# ── Vault keeper (keeper/index.js), for vaults that buy the tickets themselves ──
KEEPER_PRIVATE_KEY=
FACTORY=
# Optional: restrict to specific vaults (comma-separated addresses)
VAULTS=
# Keeper gas alert threshold, in AVAX
MIN_GAS_AVAX=0.05

# ── Factory deployment from the command line (the web page can do it instead) ──
DEPLOYER_PRIVATE_KEY=
