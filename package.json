{
  "name": "p33-lottery-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Single-owner vault: the yield of staked p33 buys BCM lottery tickets (Avalanche)",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/build.js && node --test --test-reporter=spec test/vault.test.js",
    "test:web": "node scripts/build.js && node test/e2e.js",
    "deploy": "node scripts/build.js && node scripts/deploy.js",
    "keeper": "node keeper/index.js",
    "player": "node keeper/player.js",
    "test:play": "node scripts/build.js && node test/e2e-play.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ganache": "7.9.2",
    "playwright-core": "^1.56.0",
    "solc": "0.8.26"
  }
}
